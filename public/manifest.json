{
  "manifest_version": 3,
  "name": "Course Transcript Extractor",
  "version": "6.0.0",
  "description": "Extract transcripts and readings from Udemy and Google Skills courses, one lesson or a whole course, with multiple export formats",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://*.udemy.com/*",
    "https://*.skills.google/*",
    "https://*.cloudskillsboost.google/*",
    "https://storage.googleapis.com/cloud-training/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Course Transcript Extractor"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.udemy.com/*",
        "https://*.skills.google/*",
        "https://*.cloudskillsboost.google/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
